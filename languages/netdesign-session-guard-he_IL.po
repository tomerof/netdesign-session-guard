#: src/Admin/SettingsPage.php:78
msgid "Automatic (recommended): detects Cloudflare and local proxies"
msgstr "אוטומטי (מומלץ): מזהה Cloudflare ופרוקסי מקומי"

#: src/Admin/SettingsPage.php:83
msgid "Automatic trusts a forwarding header only when the request really comes from Cloudflare or a local proxy, so visitors cannot fake their IP."
msgstr "במצב אוטומטי כותרת העברה נחשבת אמינה רק כשהבקשה באמת מגיעה מ־Cloudflare או מפרוקסי מקומי, כך שמבקרים לא יכולים לזייף את כתובת ה־IP שלהם."

#: src/Admin/SettingsPage.php:84
msgid "Store anonymized IPs"
msgstr "שמירת כתובות IP מוסתרות"

#: src/Admin/SettingsPage.php:85
msgid "Keep session history for (days)"
